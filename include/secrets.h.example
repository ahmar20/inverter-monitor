#pragma once
// ============================================================================
// secrets.h.example — template for secrets.h. Copy this file to secrets.h
// and fill in your own values. secrets.h is gitignored and must never be
// committed - only this .example file (with placeholders) belongs in git.
// ============================================================================

// ===== AUTH (used for /settings, OTA, and all /api/* write endpoints) =====
const char* SETTINGS_USER = "root";
const char* SETTINGS_PASS = "change-me";

// ===== WIFI =====
// Permanent compiled-in fallback - always tried last, even if NVS is wiped
// or every saved profile is deleted. Not shown as editable in /home normally.
#define WIFI_FALLBACK_SSID_1 "your-wifi-ssid"
#define WIFI_FALLBACK_PASS_1 "your-wifi-password"

// ===== CLOUD DB (one-time seed into NVS on first boot only - change later
// from the "Cloud Upload" section on /settings, not by re-flashing) =====
// Point this at your own backend (see README for the expected API shape),
// or leave both blank to boot with cloud upload disabled - the local flash
// queue and /history's local fallback work either way.
static const char* CLOUD_SEED_URL = "";
static const char* CLOUD_SEED_KEY = "";
